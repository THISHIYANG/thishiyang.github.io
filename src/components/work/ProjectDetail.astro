---
import type { Project } from '../../content/projects';
import { scenes } from '../../content/scenes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../SiteHeader.astro';
import DotCursor from '../cursor/DotCursor.astro';
import ProjectHeader from './ProjectHeader.astro';
import ProjectMedia from './ProjectMedia.astro';
import ProjectNavigation from './ProjectNavigation.astro';
import '../../styles/project.css';
interface Props { project: Project; previous?: Project; next?: Project }
const { project, previous, next } = Astro.props;
const data = project.data;
---
<BaseLayout>
  <div class="landing work-document" data-work-document>
    <SiteHeader />
    <nav class="scene-nav metadata" aria-label="Letter worlds">
      {scenes.map((scene) => <a href={scene.path} aria-label={scene.title} aria-current={scene.id === 'games' ? 'page' : undefined}>{scene.letter}</a>)}
    </nav>
    <main id="main" tabindex="-1">
      <article class="project-article">
        <a class="project-index-link" href="/work">← WORK INDEX</a>
        <ProjectHeader project={project} />
        {data.heroImage && <ProjectMedia images={[{ src: data.heroImage, alt: data.heroImageAlt ?? data.title, caption: data.heroCaption }]} eager />}
        <div class="project-prose"><slot /></div>
        {data.links.length > 0 && <section class="project-resource-links" aria-label="Project links"><h2>PROJECT LINKS</h2><ul>{data.links.map((link) => <li><a href={link.href}>{link.label} ↗</a></li>)}</ul></section>}
        <ProjectNavigation previous={previous} next={next} />
      </article>
    </main>
  </div>
  <DotCursor />
  <script>import { setupPointer } from '../../scripts/dot-cursor'; setupPointer();</script>
</BaseLayout>
