---
const platforms = ['INSTAGRAM', 'X', 'XIAOHONGSHU', 'TIKTOK', 'ITCH.IO'];
---
<div class="artifact social-artifact desktop-object" aria-label="Social notes">
  {platforms.map((platform, index) => (
    <a href="/social" data-scene="social" data-signature="social" class="social-note" style={`--card: ${index}`} aria-label={`${platform} — Social scene`}>
      <span>{platform}</span><span class="note-number">0{index + 1}</span>
    </a>
  ))}
</div>
