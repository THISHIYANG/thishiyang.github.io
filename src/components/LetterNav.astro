---
import { worlds } from '../content/worlds';
---
<div class="letters" role="group" aria-label="THISHI" data-letters>
{worlds.map(world => (
<button class="letter" type="button" data-world={world.id} aria-label={`${world.letter} — ${world.en}`} aria-pressed="false" aria-controls="letter-detail"><span class="letter-glyph" aria-hidden="true">{world.letter}</span></button>
))}
</div>

