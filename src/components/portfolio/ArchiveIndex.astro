---
import {portfolioChapters} from '../../content/portfolio-archive';
---
<nav class="pa-index" aria-label="Portfolio archive index" id="archive-index"><details open data-portfolio-index><summary>ARCHIVE INDEX <span aria-hidden="true">↕</span></summary><ol>{portfolioChapters.map(chapter=><li><a class="pa-category-link" href={'#chapter-'+chapter.id} data-chapter-link={chapter.id}><span>{chapter.number} /</span> {chapter.title}</a><ol>{chapter.works.map(work=><li><a href={'#work-'+work.id} data-project-link={work.id}><span>{work.id}</span> {work.name}</a></li>)}</ol></li>)}</ol><p class="pa-index-note">10 PROJECTS / 06 DISCIPLINES<br />ORIGINAL WORK IDS PRESERVED</p></details></nav>
