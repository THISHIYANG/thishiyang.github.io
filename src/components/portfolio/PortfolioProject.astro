---
import type { ArchiveWork } from '../../content/portfolio-archive';
import ArtworkPlaceholder from './ArtworkPlaceholder.astro';
import ArtworkImage from './ArtworkImage.astro';
import PortfolioProjectCaption from './PortfolioProjectCaption.astro';
interface Props { work: ArchiveWork; workNumber: string; discipline: string; href?: string }
const {work,workNumber,discipline,href}=Astro.props;
const hasArtwork=work.slots.some(slot=>slot.image);
const metrics=[['30+','PLAYTEST SESSIONS'],['¥100,000+','CROWDFUNDING'],['1026%+','FUNDING GOAL'],['1,000+','BACKERS'],['3,000+','TOTAL SALES']];
---
<article class:list={['pa-project','pa-project--'+work.id]} id={'work-'+work.id} data-portfolio-project data-work-id={work.id} aria-labelledby={'work-title-'+work.id}>
  <div class="pa-project-eyebrow"><span>WORK {workNumber}</span><span>{discipline}</span></div>
  {hasArtwork&&<PortfolioProjectCaption work={work} href={href} beforeArtwork />}
  <div class:list={['pa-slot-grid',{'pa-slot-grid--artwork':hasArtwork,'pa-slot-grid--contact-sheet':hasArtwork&&['07','08','09','10'].includes(work.id)}]}>{work.slots.map((slot,index)=>slot.image ? <ArtworkImage {...slot.image} label={slot.label} name={work.name} number={index+1} total={work.slots.length} /> : <ArtworkPlaceholder ratio={slot.ratio} workNumber={workNumber} name={work.name} slotNumber={index+1} label={slot.label} size={work.id==='04'&&index===0?'lead':'standard'} />)}</div>
  {!hasArtwork&&<PortfolioProjectCaption work={work} href={href} />}
  {work.description&&<p class="pa-description" lang="zh-CN">{work.description}</p>}
  {work.role&&<dl class="pa-responsibility"><dt>ROLE</dt><dd>{work.role}</dd></dl>}
  {work.id==='01'&&<dl class="pa-statistics" aria-label="Project achievements">{metrics.map(([value,label])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>}
</article>
