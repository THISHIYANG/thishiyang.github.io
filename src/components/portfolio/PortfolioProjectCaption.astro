---
import type { ArchiveWork } from '../../content/portfolio-archive';
interface Props { work: ArchiveWork; href?: string; beforeArtwork?: boolean }
const {work,href,beforeArtwork=false}=Astro.props;
---
  <header class:list={['pa-project-caption',{'pa-project-caption--before':beforeArtwork}]}><div><h3 id={'work-title-'+work.id}>{href?<a href={href}>{work.name}<span aria-hidden="true"> ↗</span></a>:work.name}</h3>{work.chinese&&<p class="pa-chinese" lang="zh-CN">{work.chinese}</p>}<p class="pa-project-subtitle">{work.title}</p>{work.tagline&&<p class="pa-tagline">{work.tagline}</p>}{work.gameLink&&<a class="pa-game-link" href={work.gameLink.href}>{work.gameLink.label}<span aria-hidden="true"> ↗</span></a>}</div><p class="pa-date">{work.date}</p></header>
