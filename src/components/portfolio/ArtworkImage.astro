---
interface Props { src: string; width: number; height: number; alt: string; label: string; name: string; number: number; total: number }
const {src,width,height,alt,label,name,number,total}=Astro.props;
---
<figure class="pa-artwork-image">
  <button class="pa-artwork-open" type="button" data-artwork-open data-artwork-src={src} data-artwork-title={name+' / '+label} aria-label={alt+'，放大查看'} aria-haspopup="dialog" aria-controls="portfolio-artwork-viewer">
    <img src={src} width={width} height={height} alt={alt} loading={number===1?'eager':'lazy'} decoding="async" />
  </button>
  <figcaption><span>{name} / {label}</span><span>{String(number).padStart(2,'0')} / {String(total).padStart(2,'0')}</span></figcaption>
</figure>
