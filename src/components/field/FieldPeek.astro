<div class="field-peek-layer" data-field-peek-layer hidden>
  <section
    class="field-peek"
    id="field-peek"
    data-field-peek
    role="dialog"
    aria-modal="false"
    aria-labelledby="field-peek-title"
    tabindex="-1"
  >
    <div class="field-peek-top">
      <span data-peek-eyebrow></span>
      <button type="button" class="field-peek-close" data-peek-close data-cursor="interactive" aria-label="Close card preview">×</button>
    </div>
    <h2 id="field-peek-title" data-peek-title></h2>
    <p class="field-peek-summary" data-peek-summary></p>
    <div class="field-peek-bottom">
      <span class="field-peek-meta" data-peek-meta></span>
      <a class="field-peek-open" data-peek-open data-cursor="interactive" hidden></a>
    </div>
  </section>
</div>
