---
import type { FieldItem } from '../../content/field';
interface Props { item: FieldItem }
const { item } = Astro.props;
const style = `
  --field-x:${item.x};
  --field-y:${item.y};
  --field-r:${item.rotation}deg;
  --field-w:${item.width}px;
  --field-h:${item.height}px;
  --field-z:${item.z};
`;
const attributes = {
  class: `field-card field-card--${item.type.toLowerCase()}`,
  style,
  'data-field-card': true,
  'data-field-id': item.id,
  'data-field-type': item.type,
  'data-field-year': item.year,
  'data-field-status': item.status ?? '',
  'data-peek-eyebrow': item.eyebrow ?? item.type,
  'data-peek-summary': item.summary ?? '',
  'data-peek-meta': JSON.stringify(item.meta ?? []),
  'data-peek-open-label': item.openLabel ?? 'OPEN',
  'data-cursor': 'interactive',
  'aria-controls': 'field-peek',
  'aria-expanded': false,
};
---
{item.href ? (
  <a {...attributes} href={item.href} draggable="false">
    <span class="field-card-type">{item.type}</span>
    <span class="field-card-title">{item.title}</span>
    <span class="field-card-number">{item.number}</span>
  </a>
) : (
  <div {...attributes} role="button" tabindex="0">
    <span class="field-card-type">{item.type}</span>
    <span class="field-card-title">{item.title}</span>
    <span class="field-card-number">{item.number}</span>
  </div>
)}
