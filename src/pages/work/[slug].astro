---
import { render } from 'astro:content';
import type { Project } from '../../content/projects';
import { getProjects } from '../../content/projects';
import ProjectDetail from '../../components/work/ProjectDetail.astro';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.data.slug },
    props: { project, previous: projects[index - 1], next: projects[index + 1] },
  }));
}

const { project, previous, next } = Astro.props as { project: Project; previous?: Project; next?: Project };
const { Content } = await render(project);
---
<ProjectDetail project={project} previous={previous} next={next}><Content /></ProjectDetail>
