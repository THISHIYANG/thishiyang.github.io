---
import { getDevlogReviews } from '../../content/devlogs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/devlog.css';
export async function getStaticPaths(){ return import.meta.env.DEV?[{params:{hub:'devlogs'}}]:[]; }
const entries=await getDevlogReviews();
if(!import.meta.env.DEV)return new Response(null,{status:404});
---
<BaseLayout lang="zh" noindex><main id="main" class="devlog-document" data-devlog-document data-work-document><h1>GAME DEV LOG · 本地审阅</h1><p>此目录与草稿预览均不进入正式构建。四篇均已确认公开；此处用于本地审阅。</p><ol>{entries.map(entry=><li><a href={'/preview/devlogs/'+entry.data.slug+'/'}>{entry.data.title}</a> · {entry.data.draft?'DRAFT':'公开'}</li>)}</ol></main></BaseLayout>
